# Build output
/bin/
/dist/

# Test output
*.out
*.test

# Editor build (embedded into the binary; only the placeholder is committed)
/internal/webui/dist/*
!/internal/webui/dist/.gitkeep

# Frontend dependencies and test output
/web/node_modules/
/web/test-results/
/web/playwright-report/

# Output of the examples (relative paths refer to the project folder, ADR 0020)
/examples/*/out/*
!/examples/*/out/.gitkeep
