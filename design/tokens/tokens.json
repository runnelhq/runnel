{
  "$description": "Runnel Design Tokens – einzige Quelle für Farben, Typografie, Radien, Abstände und Schatten. Format: Design Tokens Community Group (DTCG). Aus dieser Datei erzeugt `node design/tokens/build.mjs` die Datei `runnel.css`.",
  "color": {
    "strom": {
      "$description": "Markenfarbe „Strom“ – kräftiges Wasserblau. 600 ist die Hauptfarbe (Logo-Fläche, Primär-Buttons).",
      "50":  { "$type": "color", "$value": "#EEF8FD" },
      "100": { "$type": "color", "$value": "#D7EEFA" },
      "200": { "$type": "color", "$value": "#B0DDF4" },
      "300": { "$type": "color", "$value": "#7CC5EB" },
      "400": { "$type": "color", "$value": "#3FA6DD" },
      "500": { "$type": "color", "$value": "#1688C6" },
      "600": { "$type": "color", "$value": "#0A6DA6" },
      "700": { "$type": "color", "$value": "#0B5786" },
      "800": { "$type": "color", "$value": "#0F486E" },
      "900": { "$type": "color", "$value": "#113C5B" },
      "950": { "$type": "color", "$value": "#0A263C" }
    },
    "tiefe": {
      "$description": "Neutralfarbe „Tiefe“ – kühles Schiefergrau für Text, Flächen und Linien.",
      "0":   { "$type": "color", "$value": "#FFFFFF" },
      "50":  { "$type": "color", "$value": "#F6F8FA" },
      "100": { "$type": "color", "$value": "#EDF1F5" },
      "200": { "$type": "color", "$value": "#DDE3EA" },
      "300": { "$type": "color", "$value": "#C3CDD8" },
      "400": { "$type": "color", "$value": "#8F9DAC" },
      "500": { "$type": "color", "$value": "#67778A" },
      "600": { "$type": "color", "$value": "#4D5C6F" },
      "700": { "$type": "color", "$value": "#3A4758" },
      "800": { "$type": "color", "$value": "#273241" },
      "850": { "$type": "color", "$value": "#1F2935" },
      "900": { "$type": "color", "$value": "#19222E" },
      "950": { "$type": "color", "$value": "#0E151D" }
    },
    "erfolg": {
      "$description": "Erfolg – Erfolgs-Links, Status „erfolgreich“.",
      "50":  { "$type": "color", "$value": "#ECF8F1" },
      "400": { "$type": "color", "$value": "#4CC47F" },
      "500": { "$type": "color", "$value": "#22A05A" },
      "600": { "$type": "color", "$value": "#198348" },
      "700": { "$type": "color", "$value": "#146A3B" },
      "950": { "$type": "color", "$value": "#0B2A19" }
    },
    "fehler": {
      "$description": "Fehler – Fehler-Links, Status „fehlgeschlagen“, destruktive Aktionen.",
      "50":  { "$type": "color", "$value": "#FDEEEE" },
      "400": { "$type": "color", "$value": "#F07272" },
      "500": { "$type": "color", "$value": "#E04646" },
      "600": { "$type": "color", "$value": "#C53030" },
      "700": { "$type": "color", "$value": "#A12626" },
      "950": { "$type": "color", "$value": "#3A1212" }
    },
    "warnung": {
      "$description": "Warnung – Validator-Warnungen, Status „wartet“/„Retry“.",
      "50":  { "$type": "color", "$value": "#FEF6E7" },
      "400": { "$type": "color", "$value": "#F2B13D" },
      "500": { "$type": "color", "$value": "#E3940B" },
      "600": { "$type": "color", "$value": "#B87507" },
      "700": { "$type": "color", "$value": "#925C08" },
      "950": { "$type": "color", "$value": "#33210A" }
    },
    "ausdruck": {
      "$description": "Ausdruck – Indigo für Ausdrucks-Links und `{{ … }}`-Ausdrücke. Bewusst vom Markenblau abgesetzt.",
      "50":  { "$type": "color", "$value": "#EFF0FD" },
      "400": { "$type": "color", "$value": "#8489F0" },
      "500": { "$type": "color", "$value": "#5B63E0" },
      "600": { "$type": "color", "$value": "#4549C9" },
      "700": { "$type": "color", "$value": "#3638A3" },
      "950": { "$type": "color", "$value": "#1A1B45" }
    },
    "kategorie": {
      "$description": "Akzentfarben für Baustein-Kategorien (Icon-Kachel in Palette und Knoten). Nur als Kennfarbe, nie für Status.",
      "allgemein":    { "$type": "color", "$value": "#67778A" },
      "ausfuehrung":  { "$type": "color", "$value": "#0A6DA6" },
      "dateien":      { "$type": "color", "$value": "#C2700E" },
      "netzwerk":     { "$type": "color", "$value": "#0E8A8A" },
      "datenbank":    { "$type": "color", "$value": "#7B4FC9" },
      "eingabe":      { "$type": "color", "$value": "#2F7D4F" },
      "transformation": { "$type": "color", "$value": "#B5487F" },
      "fluss":        { "$type": "color", "$value": "#4D5C6F" },
      "ausgabe":      { "$type": "color", "$value": "#9A5B2E" }
    }
  },
  "font": {
    "sans": { "$type": "fontFamily", "$value": ["Inter", "Segoe UI Variable Text", "Segoe UI", "system-ui", "-apple-system", "Roboto", "Helvetica Neue", "Arial", "sans-serif"] },
    "mono": { "$type": "fontFamily", "$value": ["JetBrains Mono", "Cascadia Mono", "Consolas", "ui-monospace", "SFMono-Regular", "Menlo", "monospace"] }
  },
  "fontWeight": {
    "regular":  { "$type": "fontWeight", "$value": 400 },
    "medium":   { "$type": "fontWeight", "$value": 500 },
    "semibold": { "$type": "fontWeight", "$value": 600 },
    "bold":     { "$type": "fontWeight", "$value": 700 }
  },
  "fontSize": {
    "$description": "Editor nutzt 13 px als Basisgröße (dichte Werkzeug-Oberfläche), Website 16 px.",
    "2xs":  { "$type": "dimension", "$value": "11px" },
    "xs":   { "$type": "dimension", "$value": "12px" },
    "sm":   { "$type": "dimension", "$value": "13px" },
    "base": { "$type": "dimension", "$value": "14px" },
    "md":   { "$type": "dimension", "$value": "16px" },
    "lg":   { "$type": "dimension", "$value": "18px" },
    "xl":   { "$type": "dimension", "$value": "22px" },
    "2xl":  { "$type": "dimension", "$value": "28px" },
    "3xl":  { "$type": "dimension", "$value": "36px" },
    "4xl":  { "$type": "dimension", "$value": "48px" },
    "5xl":  { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "sm":   { "$type": "dimension", "$value": "4px" },
    "md":   { "$type": "dimension", "$value": "6px" },
    "lg":   { "$type": "dimension", "$value": "10px" },
    "xl":   { "$type": "dimension", "$value": "14px" },
    "full": { "$type": "dimension", "$value": "9999px" }
  },
  "space": {
    "$description": "4-px-Raster.",
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" },
    "24": { "$type": "dimension", "$value": "96px" }
  },
  "shadow": {
    "sm": { "$type": "shadow", "$value": "0 1px 2px rgb(14 21 29 / 0.06), 0 1px 1px rgb(14 21 29 / 0.04)" },
    "md": { "$type": "shadow", "$value": "0 4px 12px rgb(14 21 29 / 0.08), 0 1px 3px rgb(14 21 29 / 0.06)" },
    "lg": { "$type": "shadow", "$value": "0 12px 32px rgb(14 21 29 / 0.14), 0 2px 6px rgb(14 21 29 / 0.08)" }
  },
  "motion": {
    "fast":   { "$type": "duration", "$value": "120ms" },
    "normal": { "$type": "duration", "$value": "200ms" },
    "flow":   { "$type": "duration", "$value": "1200ms", "$description": "Laufanimation auf aktiven Links (Strömung)." },
    "ease":   { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] }
  },
  "theme": {
    "$description": "Semantische Rollen je Modus. Werte verweisen auf die Paletten oben. Namen der UI-Rollen entsprechen shadcn/ui.",
    "light": {
      "background":            "{color.tiefe.0}",
      "foreground":            "{color.tiefe.900}",
      "card":                  "{color.tiefe.0}",
      "card-foreground":       "{color.tiefe.900}",
      "popover":               "{color.tiefe.0}",
      "popover-foreground":    "{color.tiefe.900}",
      "primary":               "{color.strom.600}",
      "primary-foreground":    "{color.tiefe.0}",
      "secondary":             "{color.tiefe.100}",
      "secondary-foreground":  "{color.tiefe.800}",
      "muted":                 "{color.tiefe.50}",
      "muted-foreground":      "{color.tiefe.500}",
      "accent":                "{color.strom.50}",
      "accent-foreground":     "{color.strom.800}",
      "destructive":           "{color.fehler.600}",
      "destructive-foreground":"{color.tiefe.0}",
      "border":                "{color.tiefe.200}",
      "input":                 "{color.tiefe.300}",
      "ring":                  "{color.strom.500}",
      "canvas":                "{color.tiefe.50}",
      "canvas-grid":           "{color.tiefe.200}",
      "node":                  "{color.tiefe.0}",
      "node-border":           "{color.tiefe.300}",
      "node-selected":         "{color.strom.500}",
      "link-success":          "{color.erfolg.600}",
      "link-failure":          "{color.fehler.600}",
      "link-always":           "{color.tiefe.700}",
      "link-expression":       "{color.ausdruck.600}",
      "link-disabled":         "{color.tiefe.300}",
      "status-running":        "{color.strom.500}",
      "status-success":        "{color.erfolg.600}",
      "status-failed":         "{color.fehler.600}",
      "status-waiting":        "{color.warnung.600}",
      "status-skipped":        "{color.tiefe.400}",
      "success":               "{color.erfolg.600}",
      "success-soft":          "{color.erfolg.50}",
      "warning":               "{color.warnung.700}",
      "warning-soft":          "{color.warnung.50}",
      "danger-soft":           "{color.fehler.50}",
      "expression":            "{color.ausdruck.600}",
      "expression-soft":       "{color.ausdruck.50}",
      "sidebar":               "{color.tiefe.50}",
      "sidebar-foreground":    "{color.tiefe.800}",
      "sidebar-primary":       "{color.strom.600}",
      "sidebar-primary-foreground": "{color.tiefe.0}",
      "sidebar-accent":        "{color.tiefe.100}",
      "sidebar-accent-foreground": "{color.tiefe.900}",
      "sidebar-border":        "{color.tiefe.200}",
      "sidebar-ring":          "{color.strom.500}",
      "chart-1":               "{color.strom.600}",
      "chart-2":               "{color.ausdruck.500}",
      "chart-3":               "{color.kategorie.netzwerk}",
      "chart-4":               "{color.warnung.500}",
      "chart-5":               "{color.kategorie.transformation}"
    },
    "dark": {
      "background":            "{color.tiefe.950}",
      "foreground":            "{color.tiefe.100}",
      "card":                  "{color.tiefe.900}",
      "card-foreground":       "{color.tiefe.100}",
      "popover":               "{color.tiefe.900}",
      "popover-foreground":    "{color.tiefe.100}",
      "primary":               "{color.strom.400}",
      "primary-foreground":    "{color.tiefe.950}",
      "secondary":             "{color.tiefe.800}",
      "secondary-foreground":  "{color.tiefe.100}",
      "muted":                 "{color.tiefe.850}",
      "muted-foreground":      "{color.tiefe.400}",
      "accent":                "{color.strom.950}",
      "accent-foreground":     "{color.strom.200}",
      "destructive":           "{color.fehler.500}",
      "destructive-foreground":"{color.tiefe.0}",
      "border":                "{color.tiefe.800}",
      "input":                 "{color.tiefe.700}",
      "ring":                  "{color.strom.400}",
      "canvas":                "{color.tiefe.950}",
      "canvas-grid":           "{color.tiefe.800}",
      "node":                  "{color.tiefe.900}",
      "node-border":           "{color.tiefe.700}",
      "node-selected":         "{color.strom.400}",
      "link-success":          "{color.erfolg.400}",
      "link-failure":          "{color.fehler.400}",
      "link-always":           "{color.tiefe.300}",
      "link-expression":       "{color.ausdruck.400}",
      "link-disabled":         "{color.tiefe.700}",
      "status-running":        "{color.strom.400}",
      "status-success":        "{color.erfolg.400}",
      "status-failed":         "{color.fehler.400}",
      "status-waiting":        "{color.warnung.400}",
      "status-skipped":        "{color.tiefe.500}",
      "success":               "{color.erfolg.400}",
      "success-soft":          "{color.erfolg.950}",
      "warning":               "{color.warnung.400}",
      "warning-soft":          "{color.warnung.950}",
      "danger-soft":           "{color.fehler.950}",
      "expression":            "{color.ausdruck.400}",
      "expression-soft":       "{color.ausdruck.950}",
      "sidebar":               "{color.tiefe.900}",
      "sidebar-foreground":    "{color.tiefe.200}",
      "sidebar-primary":       "{color.strom.400}",
      "sidebar-primary-foreground": "{color.tiefe.950}",
      "sidebar-accent":        "{color.tiefe.800}",
      "sidebar-accent-foreground": "{color.tiefe.0}",
      "sidebar-border":        "{color.tiefe.800}",
      "sidebar-ring":          "{color.strom.400}",
      "chart-1":               "{color.strom.400}",
      "chart-2":               "{color.ausdruck.400}",
      "chart-3":               "#3FC1C1",
      "chart-4":               "{color.warnung.400}",
      "chart-5":               "#E07AAE"
    }
  }
}
